diff --git a/ports/kianv_riscv/riscv.ld b/ports/kianv_riscv/riscv.ld
new file mode 100644
index 0000000..3865564
--- /dev/null
+++ b/ports/kianv_riscv/riscv.ld
@@ -0,0 +1,60 @@
+MEMORY
+{
+  FLASH (rx)  : ORIGIN = 0x020300000, LENGTH = 0x10000000
+  PSRAM (rwx) : ORIGIN = 0x080000000, LENGTH = 0x00800000
+}
+
+__stacktop = ORIGIN(PSRAM) + LENGTH(PSRAM);
+
+ENTRY(_start)
+
+SECTIONS
+{
+    .init : {
+        . = ALIGN(4);
+        build/start.o(.text*)
+    } >FLASH
+
+    .text : {
+        . = ALIGN(4);
+        _etext = .;
+        _sidata = _etext;
+    } >FLASH
+
+    .data : AT (_sidata) {
+        . = ALIGN(4);
+        _sdata = .;
+        _ram_start = .;
+        *(.text)
+        *(.text*)
+        . = ALIGN(4);
+        *(.data)
+        *(.data*)
+        *(.sdata)
+        *(.sdata*)
+        . = ALIGN(4);
+        *(.rodata)
+        *(.rodata*)
+        *(.srodata)
+        *(.srodata*)
+        . = ALIGN(4);
+        _edata = .;
+    } >PSRAM
+
+    .bss : {
+        . = ALIGN(4);
+        _sbss = .;
+        *(.bss)
+        *(.bss*)
+        *(.sbss)
+        *(.sbss*)
+        *(COMMON)
+        . = ALIGN(4);
+        _ebss = .;
+    } >PSRAM
+
+    .heap : {
+        . = ALIGN(4);
+        _heap_start = .;
+    } >PSRAM
+}
diff --git a/ports/kianv_riscv/start.S b/ports/kianv_riscv/start.S
new file mode 100644
index 0000000..e25ff08
--- /dev/null
+++ b/ports/kianv_riscv/start.S
@@ -0,0 +1,58 @@
+#define IO_BASE 0x10000000
+#define REG_DIV (IO_BASE + 0x0010)
+.equ FREQ, 30000000
+.equ BAUDRATE, 115200
+
+.text
+.global _start
+.type _start, @function
+
+_start:
+    addi x1, zero, 0
+    addi x2, zero, 0
+    addi x3, zero, 0
+    addi x4, zero, 0
+    addi x5, zero, 0
+    addi x6, zero, 0
+    addi x7, zero, 0
+    addi x8, zero, 0
+    addi x9, zero, 0
+    addi x10, zero, 0
+    addi x11, zero, 0
+    addi x12, zero, 0
+    addi x13, zero, 0
+    addi x14, zero, 0
+    addi x15, zero, 0
+
+    la t0, REG_DIV
+    li t1, ((FREQ / 10000) << 16) | (FREQ / BAUDRATE)
+    sw t1, 0(t0)
+
+    lui sp, %hi(__stacktop)
+    addi sp, sp, %lo(__stacktop)
+
+    la a0, _sbss
+    la a1, _ebss
+    bge a0, a1, end_init_bss
+loop_init_bss:
+    addi a0, a0, 4
+    sw zero, -4(a0)
+    blt a0, a1, loop_init_bss
+end_init_bss:
+
+    la a0, _sidata
+    la a1, _sdata
+    la a2, _edata
+    bge a1, a2, end_init_data
+loop_init_data:
+    lw a3, 0(a0)
+    addi a0, a0, 4
+    addi a1, a1, 4
+    sw a3, -4(a1)
+    blt a1, a2, loop_init_data
+end_init_data:
+
+    call main
+
+halt:
+    j halt
diff --git a/ports/kianv_riscv/uart_core.c b/ports/kianv_riscv/uart_core.c
new file mode 100644
index 0000000..610357c
--- /dev/null
+++ b/ports/kianv_riscv/uart_core.c
@@ -0,0 +1,33 @@
+#include <unistd.h>
+#include <stdint.h>
+#include "py/mpconfig.h"
+#include "py/mphal.h"
+
+#define UART_BASE 0x10000000
+#define UART_TX ((volatile uint32_t *)(UART_BASE + 0x0000))
+#define UART_RX ((volatile uint8_t *)(UART_BASE + 0x0000))
+#define UART_LSR ((volatile uint8_t *)(UART_BASE + 0x0005))
+#define UART_LSR_DR 0x01
+#define UART_LSR_THRE 0x20
+
+int mp_hal_stdin_rx_chr(void) {
+    while ((*UART_LSR & UART_LSR_DR) == 0) {
+    }
+
+    return (int)*UART_RX;
+}
+
+void kianv_putchar(char c) {
+    while ((*UART_LSR & UART_LSR_THRE) == 0) {
+    }
+
+    *UART_TX = (uint32_t)(uint8_t)c;
+}
+
+mp_uint_t mp_hal_stdout_tx_strn(const char *str, mp_uint_t len) {
+    mp_uint_t n = len;
+    while (n--) {
+        kianv_putchar(*str++);
+    }
+    return len;
+}
