diff --git a/ports/kianv_riscv/Makefile b/ports/kianv_riscv/Makefile
new file mode 100644
index 0000000..5a9bbf1
--- /dev/null
+++ b/ports/kianv_riscv/Makefile
@@ -0,0 +1,58 @@
+# MicroPython for the KianV RV32IMA SoC (Tiny Tapeout), loaded by the KianV Zephyr dual-boot loader
+# from flash 0x20300000 into PSRAM at 0x80000000.
+include ../../py/mkenv.mk
+
+QSTR_DEFS = qstrdefsport.h
+MICROPY_ROM_TEXT_COMPRESSION ?= 1
+
+include $(TOP)/py/py.mk
+include $(TOP)/extmod/extmod.mk
+
+CROSS_COMPILE ?= riscv32-unknown-elf-
+ARCH ?= rv32ima_zicsr_zifencei
+
+INC += -I.
+INC += -I$(TOP)
+INC += -I$(BUILD)
+
+LD = $(CC)
+AFLAGS += -march=$(ARCH) -mabi=ilp32
+CFLAGS += $(INC) -Wall -Werror -std=c99 -march=$(ARCH) -mabi=ilp32 -fomit-frame-pointer $(COPT)
+CFLAGS += -Os -DNDEBUG -fdata-sections -ffunction-sections
+LDFLAGS ?= -march=$(ARCH) -mabi=ilp32 -ffreestanding -nostartfiles -nostdlib -Wl,-Bstatic,-T,riscv.ld
+LDFLAGS += -Wl,--gc-sections -Wl,-Map=$(BUILD)/firmware.map
+LIBS ?= -lm -lc -lgcc
+
+CSUPEROPT = -Os
+
+SRC_C = \
+	main.c \
+	uart_core.c \
+	shared/libc/printf.c \
+	shared/readline/readline.c \
+	shared/runtime/pyexec.c \
+	shared/runtime/stdout_helpers.c \
+	shared/runtime/gchelper_native.c \
+	shared/libc/string0.c
+
+SRC_S = shared/runtime/gchelper_rv32i.s
+SRC_ASM = start.S
+
+SRC_QSTR += shared/readline/readline.c shared/runtime/pyexec.c
+
+OBJ += $(PY_O)
+OBJ += $(addprefix $(BUILD)/, $(SRC_C:.c=.o))
+OBJ += $(addprefix $(BUILD)/, $(SRC_S:.s=.o))
+OBJ += $(addprefix $(BUILD)/, $(SRC_ASM:.S=.o))
+
+all: $(BUILD)/firmware.bin
+
+$(BUILD)/firmware.elf: $(OBJ)
+	$(ECHO) "LINK $@"
+	$(Q)$(LD) $(LDFLAGS) -o $@ $^ $(LIBS)
+	$(Q)$(SIZE) $@
+
+$(BUILD)/firmware.bin: $(BUILD)/firmware.elf
+	$(Q)$(OBJCOPY) -O binary -j .init -j .text -j .data $^ $@
+
+include $(TOP)/py/mkrules.mk
diff --git a/ports/kianv_riscv/main.c b/ports/kianv_riscv/main.c
new file mode 100644
index 0000000..9fe6db1
--- /dev/null
+++ b/ports/kianv_riscv/main.c
@@ -0,0 +1,109 @@
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "py/builtin.h"
+#include "py/compile.h"
+#include "py/runtime.h"
+#include "py/repl.h"
+#include "py/gc.h"
+#include "py/mphal.h"
+#include "py/mperrno.h"
+#include "shared/runtime/pyexec.h"
+#include "shared/runtime/gchelper.h"
+
+#if MICROPY_ENABLE_COMPILER
+void do_str(const char *src, mp_parse_input_kind_t input_kind) {
+    nlr_buf_t nlr;
+    if (nlr_push(&nlr) == 0) {
+        mp_lexer_t *lex = mp_lexer_new_from_str_len(MP_QSTR__lt_stdin_gt_, src, strlen(src), 0);
+        qstr source_name = lex->source_name;
+        mp_parse_tree_t parse_tree = mp_parse(lex, input_kind);
+        mp_obj_t module_fun = mp_compile(&parse_tree, source_name, true);
+        mp_call_function_0(module_fun);
+        nlr_pop();
+    } else {
+        // uncaught exception
+        mp_obj_print_exception(&mp_plat_print, (mp_obj_t)nlr.ret_val);
+    }
+}
+#endif
+
+#if MICROPY_ENABLE_GC
+// Heap: from the end of .bss (riscv.ld) to 7 MiB; the stack grows down from 8 MiB.
+extern char _heap_start[];
+static char *const heap_end = (char *)(0x80000000 + 7 * 1024 * 1024);
+#endif
+
+int main(int argc, char **argv) {
+    mp_cstack_init_with_sp_here(16 * 1024);
+
+    #if MICROPY_ENABLE_GC
+    gc_init((char *)(((uintptr_t)_heap_start + 15) & ~(uintptr_t)15), heap_end);
+    #endif
+    mp_init();
+
+    #if MICROPY_ENABLE_COMPILER
+    #if MICROPY_REPL_EVENT_DRIVEN
+    pyexec_event_repl_init();
+    for (;;) {
+        int c = mp_hal_stdin_rx_chr();
+        if (pyexec_event_repl_process_char(c)) {
+            break;
+        }
+    }
+    #else
+    pyexec_friendly_repl();
+    #endif
+    //do_str("print('hello world!', list(x+1 for x in range(10)), end='eol\\n')", MP_PARSE_SINGLE_INPUT);
+    //do_str("for i in range(10):\r\n  print(i)", MP_PARSE_FILE_INPUT);
+    #else
+    pyexec_frozen_module("frozentest.py", false);
+    #endif
+    mp_deinit();
+    return 0;
+}
+
+void gc_collect(void) {
+    gc_collect_start();
+    gc_helper_collect_regs_and_stack();
+    gc_collect_end();
+}
+
+mp_lexer_t *mp_lexer_new_from_file(qstr filename) {
+    mp_raise_OSError(MP_ENOENT);
+}
+
+mp_import_stat_t mp_import_stat(const char *path) {
+    return MP_IMPORT_STAT_NO_EXIST;
+}
+
+
+// No filesystem.
+mp_obj_t mp_builtin_open(size_t n_args, const mp_obj_t *args, mp_map_t *kwargs) {
+    mp_raise_OSError(MP_ENOENT);
+}
+MP_DEFINE_CONST_FUN_OBJ_KW(mp_builtin_open_obj, 1, mp_builtin_open);
+
+void nlr_jump_fail(void *val) {
+    while (1) {
+        ;
+    }
+}
+
+void MP_NORETURN __fatal_error(const char *msg) {
+    while (1) {
+        ;
+    }
+}
+
+#ifndef NDEBUG
+void MP_WEAK __assert_func(const char *file, int line, const char *func, const char *expr) {
+    printf("Assertion '%s' failed, at file %s:%d\n", expr, file, line);
+    __fatal_error("Assertion failed");
+}
+#endif
+
+uint32_t kianv_random_seed(void) {
+    return (uint32_t)mp_hal_ticks_cpu();
+}
