diff --git a/ports/kianv_riscv/mphalport.h b/ports/kianv_riscv/mphalport.h
new file mode 100644
index 0000000..95ce94f
--- /dev/null
+++ b/ports/kianv_riscv/mphalport.h
@@ -0,0 +1,41 @@
+#include <stdint.h>
+
+// CLINT mtime runs at 10 kHz (the boot loader sets the divider in start.S / dualboot loader).
+#define KIANV_MTIME_HZ (10000u)
+#define KIANV_MTIME_LO (*(volatile uint32_t *)0x1100bff8)
+#define KIANV_MTIME_HI (*(volatile uint32_t *)0x1100bffc)
+
+static inline uint64_t kianv_mtime(void) {
+    uint32_t hi, lo;
+    do {
+        hi = KIANV_MTIME_HI;
+        lo = KIANV_MTIME_LO;
+    } while (hi != KIANV_MTIME_HI);
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static inline mp_uint_t mp_hal_ticks_ms(void) {
+    return (mp_uint_t)(kianv_mtime() / (KIANV_MTIME_HZ / 1000u));
+}
+static inline mp_uint_t mp_hal_ticks_us(void) {
+    return (mp_uint_t)(kianv_mtime() * (1000000u / KIANV_MTIME_HZ));
+}
+static inline mp_uint_t mp_hal_ticks_cpu(void) {
+    return (mp_uint_t)kianv_mtime();
+}
+static inline uint64_t mp_hal_time_ns(void) {
+    return kianv_mtime() * (1000000000ull / KIANV_MTIME_HZ);
+}
+static inline void mp_hal_delay_ms(mp_uint_t ms) {
+    uint64_t end = kianv_mtime() + (uint64_t)ms * (KIANV_MTIME_HZ / 1000u);
+    while (kianv_mtime() < end) {
+    }
+}
+static inline void mp_hal_delay_us(mp_uint_t us) {
+    uint64_t end = kianv_mtime() + ((uint64_t)us * KIANV_MTIME_HZ + 999999u) / 1000000u;
+    while (kianv_mtime() < end) {
+    }
+}
+static inline void mp_hal_set_interrupt_char(char c) {
+    (void)c;
+}
