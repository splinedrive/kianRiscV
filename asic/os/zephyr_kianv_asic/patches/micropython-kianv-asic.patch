+#define MICROPY_PY_SYS_STDFILES             (0)
+#define MICROPY_PY_OS                       (0)
+#define MICROPY_PY_SELECT                   (0)
+#define MICROPY_PY_VFS                      (0)
+
+// time: ticks_ms/us/cpu, sleep*, time() (seconds since power-up, from the 10 kHz mtime)
